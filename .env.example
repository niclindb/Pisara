# Copy to .env.local for local runs, and set the same names in Vercel's
# project settings (Settings → Environment Variables). Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Long random strings, e.g. from `openssl rand -base64 32`.
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# Where the site lives; used in email links.
SITE_URL=http://localhost:3000

# Resend → API Keys. Leave empty to print emails to the log instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Pisara <lessons@getpisara.com>
