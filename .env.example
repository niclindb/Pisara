# Copy to .env.local for local runs, and set the same names in Vercel's
# project settings (Settings → Environment Variables). Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API: the project URL and the anon (public) key.
# These two are safe in the browser; the access rules protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API: the service_role key. Server only, never
# NEXT_PUBLIC. Lets the "Begin lesson" link in the daily email sign learners in.
# The Supabase Vercel integration already sets it in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Long random strings, e.g. from `openssl rand -base64 32`.
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# UNSUBSCRIBE_SECRET also signs the daily email's sign-in link.

# Where the site lives, with no slash at the end, e.g. https://pisara.vercel.app.
# Used in email links.
SITE_URL=http://localhost:3000

# Sending email. Leave SMTP_USER and RESEND_API_KEY empty to print emails to the
# log instead of sending.
#
# Gmail (no domain needed): SMTP_USER is the Gmail address, SMTP_PASSWORD a
# 16-letter app password (Google Account → Security → App passwords). EMAIL_FROM
# must use that same address. SMTP_HOST and SMTP_PORT default to Gmail's.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
#
# Resend (once there's a verified domain): used only when SMTP_USER is empty.
RESEND_API_KEY=
# With Gmail this must be the Gmail address: Pisara <you@gmail.com>.
EMAIL_FROM=

# The contact address on the privacy and terms pages (the Gmail address works).
# Set it before anyone else signs up; while empty, the pages leave the contact line out.
CONTACT_EMAIL=

# Local development only (npm run dev): act as this user without signing in.
# Ignored by production builds. Leave empty normally. The page tests set it to
# "cookie", which picks the user from a cookie instead.
DEV_SIGNED_IN_USER_ID=
